[default]
provider = "ollama"

[ollama]
base_url = "http://localhost:11434"
model = "qwen2.5:1.5b"
temperature = 0.7
max_tokens = 2048

[openai]
api_key = ""
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini"
temperature = 0.7
max_tokens = 4096
provider_name = "openai"

# Claude via Anthropic's OpenAI-compatible endpoint. Put ANTHROPIC_API_KEY in .env (or set api_key here).
# Optional: all of these have built-in defaults, so this section can be omitted.
[claude]
api_key = ""
base_url = "https://api.anthropic.com/v1/"
model = "claude-sonnet-5-5"
fallback_model = "claude-haiku-5-5"
stream_usage = false
provider_name = "claude"

[openrouter]
api_key = ""
base_url = "https://openrouter.ai/api/v1"
model = "openrouter/free"
fallback_model = "meta-llama/llama-3.2-3b-instruct:free"
timeout = 30
temperature = 0.7
max_tokens = 4096
provider_name = "openrouter"

[embeddings]
engine = "sentence"
